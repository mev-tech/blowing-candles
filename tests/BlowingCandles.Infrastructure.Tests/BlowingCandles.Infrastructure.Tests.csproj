    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="WireMock.Net" Version="1.25.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlowingCandles.Infrastructure\BlowingCandles.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\BlowingCandles.Domain\BlowingCandles.Domain.csproj" />
    <ProjectReference Include="..\..\src\BlowingCandles.Cli\BlowingCandles.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\yahoo-finance\**\*">
      <Link>fixtures/yahoo-finance/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
